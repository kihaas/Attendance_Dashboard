# Логин и пароль от электронного журнала
JOURNAL_USERNAME=your_login
JOURNAL_PASSWORD=your_password

# Ключ приложения (если используется API журнала)
APPLICATION_KEY=

# Минимальный процент посещаемости
REQUIRED_ATTENDANCE_PERCENT=60

# База данных (SQLite по умолчанию)
DATABASE_URL=sqlite:///./data/attendance.db